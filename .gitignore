# Dependencies
node_modules/
pnpm-lock.yaml

# Build outputs
dist/
build/

# Environment files
.env
.env.*
!.env.example

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
vite.out.log
vite.err.log

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / coverage
coverage/

# Agent-local state. Spec Kit's own repo ignores all of .specify/, but that is a
# dogfooding exception it documents as such — consumer projects commit .specify/
# and specs/ so the constitution, templates, and specs are reviewed artifacts.
# Only genuinely local or generated paths belong here.
.claude/settings.local.json
.specify/extensions/.cache/
.specify/extensions/.backup/
.specify/extensions/.registry
.specify/extensions/*/*.local.yml
